rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 2 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSafeAssetUrl(url) {
      return url is string
        && url.size() >= 5
        && url.size() <= 1024
        && (
          url.matches('^https://[^\\s]+$')
          || url.matches('^gs://[^\\s]+$')
          || url.matches('^[a-zA-Z0-9_\\-./]+$')
        );
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || request.auth.token.email == 'aravshrivastava50@gmail.com'
      );
    }

    // Validation Blueprint: PublishedGame
    function isValidPublishedGame(data) {
      return data.keys().hasAll([
          'id',
          'title',
          'creatorStudio',
          'category',
          'thumbnailUrl',
          'gameBundleUrl',
          'isLandscapeOnly',
          'legalRightsVerified',
          'ownerUid',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'title',
          'creatorStudio',
          'category',
          'subtitle',
          'description',
          'thumbnailUrl',
          'gameBundleUrl',
          'isLandscapeOnly',
          'legalRightsVerified',
          'accentColor',
          'rating',
          'activePlayersLabel',
          'xpRewardMultiplier',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 80
        && data.creatorStudio is string && data.creatorStudio.size() >= 2 && data.creatorStudio.size() <= 80
        && data.category in ['3D Action', 'Racing & Drift', 'Arcade & Reflex', '2-Player']
        && isSafeAssetUrl(data.thumbnailUrl)
        && isSafeAssetUrl(data.gameBundleUrl)
        && data.isLandscapeOnly is bool
        && data.legalRightsVerified is bool
        && isValidId(data.ownerUid)
        && (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 100))
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && (!('accentColor' in data) || (data.accentColor in ['crimson', 'cyan']))
        && (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 5))
        && (!('activePlayersLabel' in data) || (data.activePlayersLabel is string && data.activePlayersLabel.size() <= 40))
        && (!('xpRewardMultiplier' in data) || (data.xpRewardMultiplier is number && data.xpRewardMultiplier >= 0.5 && data.xpRewardMultiplier <= 5))
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Validation Blueprint: PortalSettingsConfig
    function isValidPortalSettings(data) {
      return data.keys().hasAll([
          'welcomeAnnouncement',
          'whatsappSupportNumber',
          'maintenanceMode',
          'updatedByUid',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'welcomeAnnouncement',
          'welcomeSubtitle',
          'whatsappSupportNumber',
          'maintenanceMode',
          'maintenanceMessage',
          'updatedByUid',
          'updatedAt'
        ])
        && data.welcomeAnnouncement is string
        && data.welcomeAnnouncement.size() >= 2
        && data.welcomeAnnouncement.size() <= 140
        && (!('welcomeSubtitle' in data) || (data.welcomeSubtitle is string && data.welcomeSubtitle.size() <= 200))
        && data.whatsappSupportNumber is string
        && data.whatsappSupportNumber.size() >= 6
        && data.whatsappSupportNumber.size() <= 32
        && data.whatsappSupportNumber.matches('^\\+?[0-9\\s\\-]{6,24}$')
        && data.maintenanceMode is bool
        && (!('maintenanceMessage' in data) || (data.maintenanceMessage is string && data.maintenanceMessage.size() <= 300))
        && isValidId(data.updatedByUid)
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: PlayerCloudProfile
    function isValidPlayerProfile(data) {
      return data.keys().hasAll([
          'uid',
          'gamerTag',
          'xp',
          'coins',
          'streak',
          'lastActiveDate',
          'gamesPlayed',
          'highScores',
          'preRegisteredIds',
          'equippedSkin',
          'unlockedSkins',
          'unlockedPerks',
          'soundMuted',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'gamerTag',
          'xp',
          'coins',
          'streak',
          'lastActiveDate',
          'gamesPlayed',
          'highScores',
          'preRegisteredIds',
          'equippedSkin',
          'unlockedSkins',
          'unlockedPerks',
          'soundMuted',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.gamerTag is string && data.gamerTag.size() >= 1 && data.gamerTag.size() <= 18
        && data.xp is number && data.xp >= 0 && data.xp <= 100000000
        && data.coins is number && data.coins >= 0 && data.coins <= 100000000
        && data.streak is number && data.streak >= 1 && data.streak <= 36500
        && data.lastActiveDate is string && data.lastActiveDate.size() >= 8 && data.lastActiveDate.size() <= 12
        && data.gamesPlayed is number && data.gamesPlayed >= 0 && data.gamesPlayed <= 1000000
        && data.highScores is map && data.highScores.size() <= 50
        && data.preRegisteredIds is list && data.preRegisteredIds.size() <= 50
        && (data.preRegisteredIds.size() == 0 || (data.preRegisteredIds[0] is string && data.preRegisteredIds[0].size() <= 64))
        && data.equippedSkin in ['cyber-cyan', 'crimson-hellfire', 'solar-gold', 'void-amethyst']
        && data.unlockedSkins is list && data.unlockedSkins.size() >= 1 && data.unlockedSkins.size() <= 10
        && data.unlockedSkins[0] is string && data.unlockedSkins[0].size() <= 32
        && data.unlockedPerks is list && data.unlockedPerks.size() <= 10
        && (data.unlockedPerks.size() == 0 || (data.unlockedPerks[0] is string && data.unlockedPerks[0].size() <= 32))
        && data.soundMuted is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: GlobalLeaderboardEntry
    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll([
          'id',
          'uid',
          'gamerTag',
          'gameId',
          'gameTitle',
          'score',
          'maxCombo',
          'accuracy',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'uid',
          'gamerTag',
          'gameId',
          'gameTitle',
          'score',
          'maxCombo',
          'accuracy',
          'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.uid)
        && data.gamerTag is string && data.gamerTag.size() >= 1 && data.gamerTag.size() <= 18
        && isValidId(data.gameId) && data.gameId.size() <= 64
        && data.gameTitle is string && data.gameTitle.size() >= 2 && data.gameTitle.size() <= 80
        && data.score is number && data.score >= 0 && data.score <= 10000000
        && data.maxCombo is number && data.maxCombo >= 1 && data.maxCombo <= 9999
        && data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100
        && data.createdAt is timestamp;
    }

    // Collection: /published_games/{gameId}
    match /published_games/{gameId} {
      allow get: if isValidId(gameId) && (
        existing().legalRightsVerified == true
        || isAdmin()
      );
      allow list: if resource.data.legalRightsVerified == true || isAdmin();

      allow create: if isAdmin()
        && isValidId(gameId)
        && isValidPublishedGame(incoming())
        && incoming().id == gameId
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time;

      allow update: if isAdmin()
        && isValidId(gameId)
        && isValidPublishedGame(incoming())
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && (!('updatedAt' in incoming()) || incoming().updatedAt == request.time)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'creatorStudio',
          'category',
          'subtitle',
          'description',
          'thumbnailUrl',
          'gameBundleUrl',
          'isLandscapeOnly',
          'legalRightsVerified',
          'accentColor',
          'rating',
          'activePlayersLabel',
          'xpRewardMultiplier',
          'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(gameId);
    }

    // Collection: /portal_settings/{configId}
    match /portal_settings/{configId} {
      allow get: if isValidId(configId) && (configId == 'config' || isAdmin());
      allow list: if isAdmin();

      allow create: if isAdmin()
        && isValidId(configId)
        && configId == 'config'
        && isValidPortalSettings(incoming())
        && incoming().updatedByUid == request.auth.uid
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(configId)
        && configId == 'config'
        && isValidPortalSettings(incoming())
        && incoming().updatedByUid == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'welcomeAnnouncement',
          'welcomeSubtitle',
          'whatsappSupportNumber',
          'maintenanceMode',
          'maintenanceMessage',
          'updatedByUid',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    // Collection: /players/{uid}
    match /players/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && (request.auth.uid == uid || isAdmin());
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(uid)
        && request.auth.uid == uid
        && isValidPlayerProfile(incoming())
        && incoming().uid == uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(uid)
        && (request.auth.uid == uid || isAdmin())
        && isValidPlayerProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'gamerTag',
          'xp',
          'coins',
          'streak',
          'lastActiveDate',
          'gamesPlayed',
          'highScores',
          'preRegisteredIds',
          'equippedSkin',
          'unlockedSkins',
          'unlockedPerks',
          'soundMuted',
          'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(uid);
    }

    // Collection: /leaderboard/{entryId}
    match /leaderboard/{entryId} {
      allow get: if isValidId(entryId) && existing().score >= 0;
      allow list: if resource.data.score >= 0;

      allow create: if isVerifiedUser()
        && isValidId(entryId)
        && isValidLeaderboardEntry(incoming())
        && incoming().id == entryId
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time;

      allow update, delete: if isAdmin() && isValidId(entryId);
    }

    // Collection: /admins/{uid}
    match /admins/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && (request.auth.uid == uid || isAdmin());
      allow list, create, update, delete: if false;
    }
  }
}
