{
  "entities": {
    "PublishedGame": {
      "title": "PublishedGame",
      "description": "A verified community or owner-uploaded HTML5/WebGL game published live to Shadow Knight Game Zone.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique URL-safe slug or document identifier."
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Display title of the game."
        },
        "creatorStudio": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Verified creator or studio name."
        },
        "category": {
          "type": "string",
          "enum": [
            "3D Action",
            "Racing & Drift",
            "Arcade & Reflex",
            "2-Player"
          ],
          "description": "Primary portal genre category."
        },
        "subtitle": {
          "type": "string",
          "maxLength": 100,
          "description": "Optional short tagline."
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional game overview shown on cards."
        },
        "thumbnailUrl": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1024,
          "pattern": "^(https:\\/\\/|gs:\\/\\/|[a-zA-Z0-9_\\-./]+).+",
          "description": "HTTPS URL or Firebase Storage path to the 16:9 cover artwork."
        },
        "gameBundleUrl": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1024,
          "pattern": "^(https:\\/\\/|gs:\\/\\/|[a-zA-Z0-9_\\-./]+).+",
          "description": "HTTPS URL or Firebase Storage path to the playable WebGL/HTML5 game bundle."
        },
        "isLandscapeOnly": {
          "type": "boolean",
          "description": "Enforces 16:9 Force-Landscape presentation."
        },
        "legalRightsVerified": {
          "type": "boolean",
          "description": "True only after creator agreement and legal ownership verification."
        },
        "accentColor": {
          "type": "string",
          "enum": [
            "crimson",
            "cyan"
          ],
          "description": "Card border highlight accent."
        },
        "rating": {
          "type": "number",
          "description": "Portal rating between 0 and 5."
        },
        "activePlayersLabel": {
          "type": "string",
          "maxLength": 40,
          "description": "Display player count badge text."
        },
        "xpRewardMultiplier": {
          "type": "number",
          "description": "Session XP multiplier."
        },
        "ownerUid": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the publishing admin or owner."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "id",
        "title",
        "creatorStudio",
        "category",
        "thumbnailUrl",
        "gameBundleUrl",
        "isLandscapeOnly",
        "legalRightsVerified",
        "ownerUid",
        "createdAt"
      ]
    },
    "PortalSettingsConfig": {
      "title": "PortalSettingsConfig",
      "description": "Live remote portal settings managed by the Owner Companion App or verified Owner Studio.",
      "type": "object",
      "properties": {
        "welcomeAnnouncement": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140,
          "description": "Dynamic headline announcement displayed in the Hero Spotlight welcome banner."
        },
        "welcomeSubtitle": {
          "type": "string",
          "maxLength": 200,
          "description": "Secondary announcement banner copy."
        },
        "whatsappSupportNumber": {
          "type": "string",
          "minLength": 6,
          "maxLength": 32,
          "pattern": "^\\+?[0-9\\s\\-]{6,24}$",
          "description": "Official WhatsApp support desk number shown in Support & Contact With Us."
        },
        "maintenanceMode": {
          "type": "boolean",
          "description": "When true, displays a real-time maintenance overlay across the portal."
        },
        "maintenanceMessage": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional notice displayed when maintenanceMode is active."
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the administrator who saved the config."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest settings sync."
        }
      },
      "required": [
        "welcomeAnnouncement",
        "whatsappSupportNumber",
        "maintenanceMode",
        "updatedByUid",
        "updatedAt"
      ]
    },
    "PlayerCloudProfile": {
      "title": "PlayerCloudProfile",
      "description": "Cloud-synced progression, coins, high scores, and Armory unlocks keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID owning this player profile."
        },
        "gamerTag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 18,
          "description": "Public gamer tag shown on leaderboards."
        },
        "xp": {
          "type": "number",
          "description": "Accumulated player XP."
        },
        "coins": {
          "type": "number",
          "description": "Armory currency balance."
        },
        "streak": {
          "type": "number",
          "description": "Consecutive daily login streak count."
        },
        "lastActiveDate": {
          "type": "string",
          "minLength": 8,
          "maxLength": 12,
          "description": "ISO calendar date (YYYY-MM-DD) of last activity."
        },
        "gamesPlayed": {
          "type": "number",
          "description": "Total completed game sessions."
        },
        "highScores": {
          "type": "object",
          "description": "Map of gameId to best score."
        },
        "preRegisteredIds": {
          "type": "array",
          "description": "Bounded list of pre-registered upcoming game IDs."
        },
        "equippedSkin": {
          "type": "string",
          "enum": [
            "cyber-cyan",
            "crimson-hellfire",
            "solar-gold",
            "void-amethyst"
          ],
          "description": "Currently equipped hero blade & energy skin."
        },
        "unlockedSkins": {
          "type": "array",
          "description": "Bounded list of unlocked Armory skin IDs."
        },
        "unlockedPerks": {
          "type": "array",
          "description": "Bounded list of unlocked permanent Armory perks."
        },
        "soundMuted": {
          "type": "boolean",
          "description": "Audio mute preference."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last sync timestamp."
        }
      },
      "required": [
        "uid",
        "gamerTag",
        "xp",
        "coins",
        "streak",
        "lastActiveDate",
        "gamesPlayed",
        "highScores",
        "preRegisteredIds",
        "equippedSkin",
        "unlockedSkins",
        "unlockedPerks",
        "soundMuted",
        "createdAt",
        "updatedAt"
      ]
    },
    "GlobalLeaderboardEntry": {
      "title": "GlobalLeaderboardEntry",
      "description": "Public verified score submission for the global Shadow Knight rankings.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique entry identifier."
        },
        "uid": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the player."
        },
        "gamerTag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 18,
          "description": "Player display tag."
        },
        "gameId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Game identifier."
        },
        "gameTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Display title of the game."
        },
        "score": {
          "type": "number",
          "description": "Run score."
        },
        "maxCombo": {
          "type": "number",
          "description": "Peak combo achieved."
        },
        "accuracy": {
          "type": "number",
          "description": "Hit accuracy percentage (0-100)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server submission timestamp."
        }
      },
      "required": [
        "id",
        "uid",
        "gamerTag",
        "gameId",
        "gameTitle",
        "score",
        "maxCombo",
        "accuracy",
        "createdAt"
      ]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Trusted administrator access record keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160,
          "description": "Verified administrator email."
        },
        "role": {
          "type": "string",
          "enum": [
            "owner",
            "admin"
          ],
          "description": "Administrative role tier."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": [
        "email",
        "role",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/published_games/{gameId}": {
      "schema": {
        "$ref": "#/entities/PublishedGame"
      },
      "description": "Published community and owner-uploaded games synced live to Shadow Knight Game Zone."
    },
    "/portal_settings/{configId}": {
      "schema": {
        "$ref": "#/entities/PortalSettingsConfig"
      },
      "description": "Live remote portal settings document (config)."
    },
    "/players/{uid}": {
      "schema": {
        "$ref": "#/entities/PlayerCloudProfile"
      },
      "description": "Private cloud-synced player profile, XP, coins, high scores, and Armory unlocks."
    },
    "/leaderboard/{entryId}": {
      "schema": {
        "$ref": "#/entities/GlobalLeaderboardEntry"
      },
      "description": "Public global leaderboard scores submitted by authenticated verified players."
    },
    "/admins/{uid}": {
      "schema": {
        "$ref": "#/entities/AdminRole"
      },
      "description": "Trusted portal administrator records for RBAC verification."
    }
  }
}
